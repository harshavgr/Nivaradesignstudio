# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nivara?retryWrites=true&w=majority

# Port the API server runs on
PORT=5000

# Comma separated list of allowed origins for CORS (your deployed frontend URL(s))
CLIENT_ORIGIN=http://localhost:5173

# Studio inbox email shown on the site / used for future email notifications
STUDIO_EMAIL=info@nivaradesignstudio.com
